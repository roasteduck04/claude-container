<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ClaudeApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaudeContainers">

        <!--
          Router. Runs in the main process, which is never pinned to a
          container's WebView storage, and never inflates a WebView.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The warm-container pool. One Activity per process, because
          android:process is static and WebView.setDataDirectorySuffix pins a
          process to one container's storage for its entire lifetime — so
          "keep N containers warm" literally means "declare N processes".
          Keep this list in sync with SlotStore.MAX_SLOTS and
          ProcessPool.activityForSlot.

          stateAlwaysHidden|adjustResize: don't raise the keyboard just because
          the window gained focus, and resize (don't pan) when it does appear.
        -->
        <activity
            android:name=".ContainerActivity0"
            android:exported="false"
            android:process=":c0"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity
            android:name=".ContainerActivity1"
            android:exported="false"
            android:process=":c1"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity
            android:name=".ContainerActivity2"
            android:exported="false"
            android:process=":c2"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity
            android:name=".ContainerActivity3"
            android:exported="false"
            android:process=":c3"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <!--
          Settings declares no android:process, so it runs in the main process
          alongside the router — deliberately, since it never creates a WebView
          and so has no business in a storage-pinned process. It edits
          settings.json; the container processes re-read it on resume.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
          Trampoline for the one case warm switching can't cover: tearing down
          the process whose own container is being removed. It must live in a
          separate process so it survives killing the caller.
        -->
        <activity
            android:name=".PhoenixActivity"
            android:exported="false"
            android:process=":phoenix"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
